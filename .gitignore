# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
dist/
*.egg-info/

# Node (M4+)
node_modules/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Local agent settings
.claude/settings.local.json

# Figures written outside docs/plots/ while exploring a shape. The tracked ones
# come from `make plots`; ad-hoc ones at the repo root do not.
/timeline-*.png
/timeline-*.html
/animate-*.html
/matmul-*.py

# Figures. Every picture in docs/plots/ is an output of `make plots` —
# regenerable by running the engine, so it does not belong in history. The
# README that documents the set stays tracked.
docs/plots/*.png
docs/plots/*.html
backend/timeline-*.png
backend/timeline-*.html
backend/animate-*.html

# Emitted kernel programs (`bwz matmul --emit`, D54). An output of the engine
# like the figures are, and regenerable the same way.
docs/plots/matmul-*.py
backend/matmul-*.py

# Source papers for chip profiles. Cited by DOI in the profile's source_url and
# read to build it; not redistributed here, because they are not ours to relicense.
backend/*.pdf
